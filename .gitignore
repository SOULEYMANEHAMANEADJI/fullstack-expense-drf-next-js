# ========== GLOBAL ==========

# macOS
.DS_Store

# certificate/keys
*.pem

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment variables
.env*
.env.*


# ========== FRONTEND ==========
# (ex: ./frontend)

# node modules
/frontend/node_modules/
/frontend/.pnp
/frontend/.pnp.*
/frontend/.next/
/frontend/out/
/frontend/build

# yarn v2+
/frontend/.yarn/*
!/frontend/.yarn/patches
!/frontend/.yarn/plugins
!/frontend/.yarn/releases
!/frontend/.yarn/versions

# tests
/frontend/coverage
/frontend/coverage/

# pytest coverage
/backend/.coverage
/backend/.coverage.*
/backend/htmlcov/
/backend/htmlcov/*
/backend/coverage.xml
/backend/.pytest_cache/
/backend/.pytest_cache/*

# TypeScript
/frontend/next-env.d.ts
/frontend/*.tsbuildinfo

# Vercel
/frontend/.vercel


# ========== BACKEND ==========
# (ex: ./backend)

# python virtual env
/backend/env/
/backend/venv/
/backend/.venv/

# compiled python files
*.pyc
*.pyo
*.pyd
__pycache__/
*.so
*.egg
*.egg-info/
dist/
build/

# pytest cache
.pytest_cache/
.pytest_cache/*

# Django specific
/backend/db.sqlite3
/backend/staticfiles/
.backend/media/

# ========== IDE / EDITOR ==========
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
Thumbs.db
.DS_Store
